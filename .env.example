# Сеть: mainnet или testnet
NETWORK=mainnet

# URL-адрес вашей приватной RPC ноды Sui (Mainnet)
SUI_RPC_URL=https://your-private-rpc-node-here.com

# URL Sui GraphQL RPC (современный стандарт; JSON-RPC объявлен устаревшим).
# По умолчанию: https://graphql.mainnet.sui.io/graphql (или .../testnet...)
# SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql

# URL сырого JSON-файла реестра спама (список package id мошеннических коллекций/токенов).
# Ожидаемая форма: { "packages": ["0x…", ...] } (или просто массив строк).
# Кэшируется на сервере 1 час; пустое значение = список не загружается.
# SPAM_REGISTRY_URL=https://raw.githubusercontent.com/your-org/sui-spam-list/main/spam_registry.json

# Публичный адрес кошелька вашей команды для сбора комиссий
SERVICE_FEE_ADDRESS=0xyour_treasury_wallet_address_here

# Порт для запуска веб-сервера (по умолчанию 4173)
PORT=4173

# Отключить встроенный ограничитель частоты запросов (Rate Limiter)
# Полезно, если вы используете внешнее решение (Nginx limit_req, Cloudflare Rate Limiting и т.д.)
DISABLE_RATE_LIMITER=false

# URL агрегатора котировок Cetus для шага обмена (swap) конвейера конвертации в SUI.
# По умолчанию: https://api-sui.cetus.zone/router_v3/find_routes (основная сеть).
# CETUS_QUOTE_URL=https://api-sui.cetus.zone/router_v3/find_routes
# Версия API агрегатора Cetus (по умолчанию 1010701).
# CETUS_QUOTE_VERSION=1010701

# API-ключ Blockberry для обогащения portfolio (опционально; без него используется RPC fallback).
# BLOCKBERRY_API_KEY=

# Подробное логирование AI-провайдера (dev only; ключи никогда не логируются).
# Включено везде, кроме production, по умолчанию.
# AI_DEBUG=1
